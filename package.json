{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "prepare": "node .husky/install.mjs",
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "rm -rf dist && echo 'Building Phase 2 with cookie-parser + uuid dependencies' && npx vite build && npx esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:prerender": "npm run build && node scripts/prerender.mjs",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:unit": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:auth": "playwright test auth-persistence",
    "test:auth:debug": "playwright test auth-persistence --debug --headed",
    "test:gdpr": "playwright test gdpr-compliance-comprehensive --config playwright-gdpr.config.ts --project=chromium-gdpr",
    "test:gdpr:all": "playwright test gdpr-compliance-comprehensive --config playwright-gdpr.config.ts",
    "test:gdpr:debug": "playwright test gdpr-compliance-comprehensive --config playwright-gdpr.config.ts --debug --headed --project=chromium-gdpr",
    "test:gdpr:report": "playwright test gdpr-compliance-comprehensive --config playwright-gdpr.config.ts --reporter=html",
    "test:gdpr:inspect": "node scripts/inspect-gdpr.js",
    "test:gdpr:run": "node scripts/run-gdpr-tests.js",
    "test:payments": "playwright test growth-scale-payment-flows --config=playwright.growth-scale-payment.config.ts",
    "test:payments:debug": "playwright test growth-scale-payment-flows --config=playwright.growth-scale-payment.config.ts --debug --headed",
    "test:payments:report": "playwright test growth-scale-payment-flows --config=playwright.growth-scale-payment.config.ts --reporter=html",
    "test:payments:full": "./run-growth-scale-payment-tests.sh",
    "test:uat": "npx playwright test --config=playwright.uat.config.ts",
    "test:uat:free": "./scripts/run-uat-tests.sh free production",
    "test:uat:coffee": "./scripts/run-uat-tests.sh coffee production",
    "test:uat:growth": "./scripts/run-uat-tests.sh growth production",
    "test:uat:scale": "./scripts/run-uat-tests.sh scale production",
    "test:uat:auth": "./scripts/run-uat-tests.sh auth production",
    "test:uat:payment": "./scripts/run-uat-tests.sh payment production",
    "test:uat:mobile": "./scripts/run-uat-tests.sh mobile production",
    "test:uat:desktop": "./scripts/run-uat-tests.sh desktop production",
    "test:uat:debug": "./scripts/run-uat-tests.sh debug",
    "test:uat:ui": "./scripts/run-uat-tests.sh ui",
    "test:uat:ci": "./scripts/run-uat-tests.sh ci",
    "test:uat:report": "npx playwright show-report tests/reports/uat-html-report",
    "test:uat:clean": "./scripts/run-uat-tests.sh clean",
    "test:uat:local": "./scripts/run-uat-tests.sh all local",
    "test:uat:staging": "./scripts/run-uat-tests.sh all staging",
    "test:uat:production": "./scripts/run-uat-tests.sh all production",
    "db:push": "drizzle-kit push",
    "migrate": "node scripts/migrate.js run postgres",
    "migrate:supabase": "node scripts/migrate.js run supabase",
    "migrate:status": "node scripts/migrate.js status postgres",
    "migrate:status:supabase": "node scripts/migrate.js status supabase",
    "migrate:reset": "node scripts/migrate.js reset postgres",
    "migrate:reset:supabase": "node scripts/migrate.js reset supabase",
    "db:migrate": "npm run migrate",
    "test:environment": "tsx scripts/test-environment-setup.ts",
    "benchmark:performance": "tsx scripts/run-performance-benchmarks.ts",
    "benchmark:clustering": "tsx scripts/run-performance-benchmarks.ts --suite clustering",
    "benchmark:embeddings": "tsx scripts/run-performance-benchmarks.ts --suite embeddings",
    "benchmark:database": "tsx scripts/run-performance-benchmarks.ts --suite database",
    "benchmark:integration": "tsx scripts/run-performance-benchmarks.ts --suite integration",
    "benchmark:verbose": "tsx scripts/run-performance-benchmarks.ts --verbose",
    "benchmark:report": "tsx scripts/run-performance-benchmarks.ts --output markdown",
    "health-check": "node scripts/health-check.js",
    "setup": "node scripts/setup.js",
    "setup:database": "./scripts/setup-database.sh",
    "api:create-key": "tsx scripts/create-api-key.ts"
  },
