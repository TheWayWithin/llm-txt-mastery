echo "🔍 Running pre-commit checks..."

# TypeScript gate: full-project tsc compared against the committed baseline
# (.tsc-baseline.txt). Fails ONLY on new errors; the 261 pre-existing errors
# are recorded debt (see ISSUES.md) and burn down via --update as they're fixed.
echo "📝 Checking TypeScript (baseline gate)..."
node scripts/check-types-baseline.mjs
if [ $? -ne 0 ]; then
  echo "❌ TypeScript check failed"
  exit 1
fi

# Run tests on staged files
echo "🧪 Running tests on staged files..."

# Get staged TypeScript files
STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | grep -v '.d.ts$')

if [ ! -z "$STAGED_TS_FILES" ]; then
  echo "📊 Running unit tests for changed files..."

  # Run tests for frontend files
  STAGED_CLIENT_FILES=$(echo "$STAGED_TS_FILES" | grep '^client/')
  if [ ! -z "$STAGED_CLIENT_FILES" ]; then
    echo "⚛️ Testing frontend changes..."
    npm run test:run -- --changed --coverage.enabled=false --run
    if [ $? -ne 0 ]; then
      echo "❌ Frontend tests failed"
      exit 1
    fi
  fi

  # Run tests for backend files (vitest is this repo's runner; jest is not installed)
  STAGED_SERVER_FILES=$(echo "$STAGED_TS_FILES" | grep '^server/')
  if [ ! -z "$STAGED_SERVER_FILES" ]; then
    echo "🖥️ Testing backend changes..."
    npx vitest related --run --passWithNoTests $STAGED_SERVER_FILES
    if [ $? -ne 0 ]; then
      echo "❌ Backend tests failed"
      exit 1
    fi
  fi
fi

# Check for semantic enhancement specific files
SEMANTIC_FILES=$(echo "$STAGED_TS_FILES" | grep -E '(semantic|cluster|embedding)')
if [ ! -z "$SEMANTIC_FILES" ]; then
  echo "🧠 Semantic enhancement files detected, running additional checks..."

  # Run performance benchmarks on semantic changes (quick subset)
  echo "⚡ Running performance checks..."
  if [ -f "scripts/performance-testing-harness.ts" ]; then
    # Run a quick performance check
    timeout 60 npx tsx scripts/performance-testing-harness.ts ./test-data ./temp-perf-results || echo "⚠️ Performance check timed out or failed"
    rm -rf ./temp-perf-results
  fi
fi

# Check for hardcoded credential ASSIGNMENTS (name = "value"), not bare word
# mentions — the old word-grep blocked any file containing e.g. "token".
# Primary secret scan is gitleaks in the global hook (~/.git-hooks/pre-commit).
echo "🔒 Checking for hardcoded credentials..."
CRED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -v -E '\.(md|txt|example)$' | grep -v '^\.husky/' || true)
if [ ! -z "$CRED_FILES" ]; then
  CRED_HITS=$(echo "$CRED_FILES" | xargs grep -l -i -E "(api[_-]?key|password|secret|token)[A-Za-z0-9_]*[\"']?[[:space:]]*[:=][[:space:]]*[\"'][A-Za-z0-9_/+.-]{12,}" 2>/dev/null || true)
  if [ ! -z "$CRED_HITS" ]; then
    echo "❌ Possible hardcoded credential assignment detected in:"
    echo "$CRED_HITS"
    echo "Real values belong only in a gitignored .env."
    exit 1
  fi
fi

# Check for console.log statements in production code
echo "🔍 Checking for console.log statements..."
CONSOLE_CANDIDATES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$' | grep -v -E '(test|spec|\.d\.ts)$' || true)
if [ ! -z "$CONSOLE_CANDIDATES" ]; then
  CONSOLE_LOGS=$(echo "$CONSOLE_CANDIDATES" | xargs grep -n "console\.log" 2>/dev/null || true)
  if [ ! -z "$CONSOLE_LOGS" ]; then
    echo "⚠️ console.log statements found in production code:"
    echo "$CONSOLE_LOGS"
    echo "Consider removing or replacing with proper logging"
    # Don't fail, just warn
  fi
fi

# Format check (if prettier is configured and TS files are staged)
if [ ! -z "$STAGED_TS_FILES" ] && { [ -f ".prettierrc" ] || [ -f "prettier.config.js" ]; }; then
  echo "💅 Checking code formatting..."
  npx prettier --check $STAGED_TS_FILES || {
    echo "❌ Code formatting issues detected"
    echo "Run 'npm run format' to fix formatting issues"
    exit 1
  }
fi

# Lint check (if ESLint is configured and TS files are staged)
if [ ! -z "$STAGED_TS_FILES" ] && { [ -f ".eslintrc.js" ] || [ -f ".eslintrc.json" ]; }; then
  echo "🔍 Running ESLint..."
  npx eslint $STAGED_TS_FILES || {
    echo "❌ ESLint issues detected"
    echo "Please fix linting issues before committing"
    exit 1
  }
fi

echo "✅ Pre-commit checks passed!"
