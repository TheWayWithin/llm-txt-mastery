# Database Configuration
DATABASE_URL=your_postgresql_connection_string_here

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL Database Details (automatically set by Replit)
PGHOST=your_db_host
PGPORT=5432
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGDATABASE=your_db_name

# Stripe Configuration (Server)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_LLM_TXT_COFFEE_PRICE_ID=price_llm_txt_coffee_onetime_id_here
STRIPE_LLM_TXT_GROWTH_PRICE_ID=price_llm_txt_growth_monthly_id_here
STRIPE_LLM_TXT_SCALE_PRICE_ID=price_llm_txt_scale_monthly_id_here

# Stripe Configuration (Client - Vite)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Frontend API Configuration (Vite)
# For production deployments, set this to your backend URL
# Leave empty for development (uses relative URLs)
VITE_API_URL=

# Development Environment
NODE_ENV=development

# Email Service Configuration (Optional - uses console logging in dev if not set)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=LLM.txt Mastery <noreply@llmtxtmastery.com>

# JWT Secret for tokens (should be a long random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Redis Configuration for Embedding Cache
REDIS_HOST=your_redis_host_here
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# Semantic Enhancement Configuration
# OpenAI Embeddings Model (text-embedding-3-small = 1536 dimensions)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# AI Cost Cap Configuration
# Set to true to enforce cost caps (default: false for monitoring only)
ENABLE_AI_COST_CAPS=false
# Monthly AI cost budget for Growth tier in USD (80% of $9.95)
AI_COST_CAP_GROWTH=8.00
# Monthly AI cost budget for Scale tier in USD (80% of $19.95) 
AI_COST_CAP_SCALE=16.00
# Alert threshold as percentage of budget (0.7 = alert at 70%)
AI_COST_ALERT_THRESHOLD=0.7

# Embedding Cache Settings
EMBEDDING_CACHE_TTL_DAYS=7
EMBEDDING_BATCH_SIZE=100
EMBEDDING_RATE_LIMIT_PER_MINUTE=3000

# Clustering Configuration
CLUSTERING_MIN_PAGES=3
CLUSTERING_MAX_CLUSTERS=10
CLUSTERING_COHERENCE_THRESHOLD=0.7
CLUSTERING_ALGORITHM=k-means

# Semantic Analysis Settings  
SEMANTIC_SIMILARITY_THRESHOLD=0.8
UNIQUENESS_SCORE_THRESHOLD=0.8
TAG_EXTRACTION_CONFIDENCE_THRESHOLD=0.6

# Development Features (set to 'true' to enable)
ENABLE_SEMANTIC_FEATURES=false
ENABLE_CLUSTERING_DEBUG=false
ENABLE_EMBEDDING_CACHE_STATS=true